<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoiceTranslatorApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="VoiceTranslatorApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Голосовой переводчик"
        Background="#0F172A">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="18" RowSpacing="16">
        <Border Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="14"
                Padding="6">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="VoiceModelsButton"
                        Grid.Column="0"
                        Click="ShowVoiceModels"
                        Background="#2563EB"
                        Foreground="White"
                        CornerRadius="10"
                        FontWeight="SemiBold"
                        FontSize="15"
                        Padding="14,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="🎙"/>
                        <TextBlock Text="Голосовые модели"/>
                    </StackPanel>
                </Button>

                <Button x:Name="TranslationButton"
                        Grid.Column="1"
                        Click="ShowTranslation"
                        Background="#1E293B"
                        Foreground="#E2E8F0"
                        CornerRadius="10"
                        FontWeight="SemiBold"
                        FontSize="15"
                        Padding="14,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="🌍"/>
                        <TextBlock Text="Перевод"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                ClipToBounds="True">
            <Grid>
                <Grid x:Name="VoiceModelsPanel" IsVisible="True">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                        <TextBlock Text="Голосовые модели" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Grid.Row="1"
                                   Text="Раздел для управления голосовыми моделями."
                                   TextWrapping="Wrap"
                                   Foreground="#94A3B8"/>
                        <Border Grid.Row="2"
                                Background="#0B1220"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="12"
                                MinHeight="220"
                                VerticalAlignment="Stretch"/>
                    </Grid>
                </Grid>

                <Grid x:Name="TranslationPanel" IsVisible="False">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                        <TextBlock Text="Перевод" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Grid.Row="1"
                                   Text="Раздел для перевода и подготовки текста."
                                   TextWrapping="Wrap"
                                   Foreground="#94A3B8"/>
                        <Border Grid.Row="2"
                                Background="#0B1220"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                MinHeight="220"
                                VerticalAlignment="Stretch">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="12">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                                        <TextBlock Text="С какого переводим"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <ComboBox x:Name="SourceLanguageComboBox"
                                                  SelectedIndex="0"
                                                  Background="#111827"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#334155"
                                                  BorderThickness="1"
                                                  CornerRadius="8"
                                                  Padding="12,10"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Русский"/>
                                            <ComboBoxItem Content="Английский"/>
                                            <ComboBoxItem Content="Немецкий"/>
                                            <ComboBoxItem Content="Французский"/>
                                            <ComboBoxItem Content="Испанский"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8">
                                        <TextBlock Text="На какой переводим"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <ComboBox x:Name="TargetLanguageComboBox"
                                                  SelectedIndex="1"
                                                  Background="#111827"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#334155"
                                                  BorderThickness="1"
                                                  CornerRadius="8"
                                                  Padding="12,10"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Русский"/>
                                            <ComboBoxItem Content="Английский"/>
                                            <ComboBoxItem Content="Немецкий"/>
                                            <ComboBoxItem Content="Французский"/>
                                            <ComboBoxItem Content="Испанский"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                                        <TextBlock Text="Устройство ввода"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <ComboBox x:Name="InputDeviceComboBox"
                                                  SelectedIndex="0"
                                                  Background="#111827"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#334155"
                                                  BorderThickness="1"
                                                  CornerRadius="8"
                                                  Padding="12,10"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Устройство вывода"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <ComboBox x:Name="OutputDeviceComboBox"
                                                  SelectedIndex="0"
                                                  Background="#111827"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#334155"
                                                  BorderThickness="1"
                                                  CornerRadius="8"
                                                  Padding="12,10"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="48*,4*,48*">
                                    <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Text="Оригинальный текст"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <TextBox Grid.Row="1"
                                                 x:Name="OriginalTextTextBox"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="True"
                                                 Focusable="False"
                                                 Watermark="Здесь появится текст до перевода"
                                                 Background="#111827"
                                                 Foreground="#E2E8F0"
                                                 BorderBrush="#334155"
                                                 BorderThickness="1"
                                                 CornerRadius="8"
                                                 Padding="12"
                                                 TextWrapping="Wrap"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VerticalAlignment="Stretch"
                                                 VerticalContentAlignment="Top"/>
                                    </Grid>

                                    <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Text="Переведённый текст"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <TextBox Grid.Row="1"
                                                 x:Name="TranslatedTextTextBox"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="True"
                                                 Focusable="False"
                                                 Watermark="Здесь появится переведённый текст"
                                                 Background="#111827"
                                                 Foreground="#E2E8F0"
                                                 BorderBrush="#334155"
                                                 BorderThickness="1"
                                                 CornerRadius="8"
                                                 Padding="12"
                                                 TextWrapping="Wrap"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VerticalAlignment="Stretch"
                                                 VerticalContentAlignment="Top"/>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="2*,6*,2*">
                                    <Button x:Name="StartTranslationButton"
                                            Grid.Column="1"
                                            Click="StartTranslation"
                                            Content="Начать перевод"
                                            Background="#16A34A"
                                            Foreground="White"
                                            CornerRadius="12"
                                            Height="56"
                                            FontWeight="Bold"
                                            FontSize="18"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            TextBlock.TextAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Bottom"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>

</Window>
