<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoiceTranslatorApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="VoiceTranslatorApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Голосовой переводчик"
        Background="#0F172A">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="18" RowSpacing="16">
        <Border Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="14"
                Padding="6">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="VoiceModelsButton"
                        Grid.Column="0"
                        Click="ShowVoiceModels"
                        Background="#2563EB"
                        Foreground="White"
                        CornerRadius="10"
                        FontWeight="SemiBold"
                        FontSize="15"
                        Padding="14,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        
                        <TextBlock Text="Голосовые модели"/>
                    </StackPanel>
                </Button>

                <Button x:Name="TranslationButton"
                        Grid.Column="1"
                        Click="ShowTranslation"
                        Background="#1E293B"
                        Foreground="#E2E8F0"
                        CornerRadius="10"
                        FontWeight="SemiBold"
                        FontSize="15"
                        Padding="14,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        
                        <TextBlock Text="Перевод"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                ClipToBounds="True">
            <Grid>
                <Grid x:Name="VoiceModelsPanel" IsVisible="True">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                        <TextBlock Text="Голосовые модели" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Grid.Row="1"
                                   Text="Настройте скорость в облаке и тон/громкость локально — ползунки ниже сразу слышны в превью."
                                   TextWrapping="Wrap"
                                   Foreground="#94A3B8"/>
                        <Border Grid.Row="2"
                                Background="#0B1220"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                MinHeight="220"
                                VerticalAlignment="Stretch">
                            <Grid ColumnDefinitions="3*,7*" ColumnSpacing="16">
                                <Border Background="#0B1220"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                        <TextBlock Text="Список моделей"
                                                   Foreground="#E2E8F0"
                                                   FontWeight="SemiBold"/>

                                        <ListBox x:Name="VoiceModelsListBox"
                                                 Grid.Row="1"
                                                 Background="#111827"
                                                 BorderBrush="#334155"
                                                 BorderThickness="1"
                                                 CornerRadius="8"
                                                 Padding="8"
                                                 Foreground="#E2E8F0"/>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="NewVoiceModelButton"
                                                    Click="NewVoiceModel"
                                                    Background="#2563EB"
                                                    Foreground="White"
                                                    CornerRadius="8"
                                                    Padding="10,8"
                                                    FontWeight="SemiBold"
                                                    Content="Новая"/>
                                            <Button x:Name="DeleteVoiceModelButton"
                                                    Click="DeleteVoiceModel"
                                                    Background="#DC2626"
                                                    Foreground="White"
                                                    CornerRadius="8"
                                                    Padding="10,8"
                                                    FontWeight="SemiBold"
                                                    Content="Удалить"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#0B1220"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
                                        <TextBlock Grid.Row="0"
                                                   Text="Параметры модели"
                                                   Foreground="#E2E8F0"
                                                   FontWeight="SemiBold"/>

                                        <StackPanel Grid.Row="1" Spacing="6">
                                            <TextBlock Text="Название"
                                                       Foreground="#CBD5E1"
                                                       FontSize="14"/>
                                            <TextBox x:Name="VoiceModelNameTextBox"
                                                     Background="#111827"
                                                     Foreground="#E2E8F0"
                                                     BorderBrush="#334155"
                                                     BorderThickness="1"
                                                     CornerRadius="8"
                                                     Padding="12,10"
                                                     Watermark="Например: Мой спокойный голос"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Spacing="6">
                                            <TextBlock Text="Скорость речи (Yandex)"
                                                       Foreground="#CBD5E1"
                                                       FontSize="14"/>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Slider x:Name="VoiceModelSpeedSlider"
                                                        Minimum="0.5"
                                                        Maximum="2.0"
                                                        Value="1.0"
                                                        TickFrequency="0.1"
                                                        IsSnapToTickEnabled="True"/>
                                                <TextBlock x:Name="VoiceModelSpeedValueTextBlock"
                                                           Grid.Column="1"
                                                           Text="1.0"
                                                           Foreground="#E2E8F0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Spacing="6">
                                            <TextBlock Text="Тон (высота, полутоны)"
                                                       Foreground="#CBD5E1"
                                                       FontSize="14"/>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Slider x:Name="VoiceModelPitchSlider"
                                                        Minimum="-6"
                                                        Maximum="6"
                                                        Value="0"
                                                        TickFrequency="0.5"
                                                        IsSnapToTickEnabled="True"/>
                                                <TextBlock x:Name="VoiceModelPitchValueTextBlock"
                                                           Grid.Column="1"
                                                           Text="0"
                                                           Foreground="#E2E8F0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           MinWidth="36"
                                                           TextAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Spacing="6">
                                            <TextBlock Text="Громкость"
                                                       Foreground="#CBD5E1"
                                                       FontSize="14"/>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Slider x:Name="VoiceModelGainSlider"
                                                        Minimum="0.25"
                                                        Maximum="2.0"
                                                        Value="1.0"
                                                        TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"/>
                                                <TextBlock x:Name="VoiceModelGainValueTextBlock"
                                                           Grid.Column="1"
                                                           Text="1.00"
                                                           Foreground="#E2E8F0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           MinWidth="44"
                                                           TextAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Grid.Row="5"
                                                   Text="Тон и громкость применяются к уже полученному звуку на этом компьютере (не параметры Yandex API)."
                                                   TextWrapping="Wrap"
                                                   Foreground="#64748B"
                                                   FontSize="12"/>

                                        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="SaveVoiceModelButton"
                                                    Click="SaveVoiceModel"
                                                    Background="#16A34A"
                                                    Foreground="White"
                                                    CornerRadius="8"
                                                    Padding="12,10"
                                                    FontWeight="SemiBold"
                                                    Content="Сохранить"/>
                                            <Button x:Name="PreviewVoiceModelButton"
                                                    Click="PreviewVoiceModel"
                                                    Background="#1E293B"
                                                    Foreground="#E2E8F0"
                                                    BorderBrush="#334155"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,10"
                                                    FontWeight="SemiBold"
                                                    Content="Прослушать"/>
                                        </StackPanel>

                                        <Grid Grid.Row="7" RowDefinitions="Auto,*" MinHeight="0">
                                            <TextBlock Text="Текст для прослушивания"
                                                       Foreground="#CBD5E1"
                                                       FontSize="14"/>
                                            <TextBox x:Name="VoiceModelPreviewTextBox"
                                                     Grid.Row="1"
                                                     AcceptsReturn="True"
                                                     MinHeight="0"
                                                     VerticalAlignment="Stretch"
                                                     VerticalContentAlignment="Top"
                                                     Text="Привет! Это тест вашего голосового пресета для озвучки перевода."
                                                     Background="#111827"
                                                     Foreground="#E2E8F0"
                                                     BorderBrush="#334155"
                                                     BorderThickness="1"
                                                     CornerRadius="8"
                                                     Padding="12"
                                                     TextWrapping="Wrap"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="TranslationPanel" IsVisible="False">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                        <TextBlock Text="Перевод" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Grid.Row="1"
                                   Text="Выберите языки, модель озвучки и устройства, затем нажмите «Начать перевод»."
                                   TextWrapping="Wrap"
                                   Foreground="#94A3B8"/>
                        <Border Grid.Row="2"
                                Background="#0B1220"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                MinHeight="220"
                                VerticalAlignment="Stretch">
                            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                                <Border Grid.Row="0"
                                        Background="#1E293B"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <TextBlock x:Name="TranslationPhaseStatusTextBlock"
                                               Text="Перевод не запущен. Выберите языки, модель озвучки и нажмите «Начать перевод»."
                                               Foreground="#E2E8F0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8">
                                        <TextBlock Text="Модель озвучки"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <ComboBox x:Name="TranslationVoiceModelComboBox"
                                                  Background="#111827"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#334155"
                                                  BorderThickness="1"
                                                  CornerRadius="8"
                                                  Padding="12,10"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                                        <TextBlock Text="С какого переводим"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <ComboBox x:Name="SourceLanguageComboBox"
                                                  SelectedIndex="0"
                                                  Background="#111827"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#334155"
                                                  BorderThickness="1"
                                                  CornerRadius="8"
                                                  Padding="12,10"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Русский"/>
                                            <ComboBoxItem Content="Английский"/>
                                            <ComboBoxItem Content="Немецкий"/>
                                            <ComboBoxItem Content="Французский"/>
                                            <ComboBoxItem Content="Испанский"/>
                                            <ComboBoxItem Content="Португальский"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                                        <TextBlock Text="На какой переводим"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <ComboBox x:Name="TargetLanguageComboBox"
                                                  SelectedIndex="1"
                                                  Background="#111827"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#334155"
                                                  BorderThickness="1"
                                                  CornerRadius="8"
                                                  Padding="12,10"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Русский"/>
                                            <ComboBoxItem Content="Английский"/>
                                            <ComboBoxItem Content="Немецкий"/>
                                            <ComboBoxItem Content="Французский"/>
                                            <ComboBoxItem Content="Испанский"/>
                                            <ComboBoxItem Content="Португальский"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="8">
                                        <TextBlock Text="Устройство ввода"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <ComboBox x:Name="InputDeviceComboBox"
                                                  SelectedIndex="0"
                                                  Background="#111827"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#334155"
                                                  BorderThickness="1"
                                                  CornerRadius="8"
                                                  Padding="12,10"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Устройство вывода"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <ComboBox x:Name="OutputDeviceComboBox"
                                                  SelectedIndex="0"
                                                  Background="#111827"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#334155"
                                                  BorderThickness="1"
                                                  CornerRadius="8"
                                                  Padding="12,10"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="48*,4*,48*">
                                    <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Text="Оригинальный текст"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <TextBox Grid.Row="1"
                                                 x:Name="OriginalTextTextBox"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="True"
                                                 Focusable="False"
                                                 Watermark="Здесь появится текст до перевода"
                                                 Background="#111827"
                                                 Foreground="#E2E8F0"
                                                 BorderBrush="#334155"
                                                 BorderThickness="1"
                                                 CornerRadius="8"
                                                 Padding="12"
                                                 TextWrapping="Wrap"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VerticalAlignment="Stretch"
                                                 VerticalContentAlignment="Top"/>
                                    </Grid>

                                    <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Text="Переведённый текст"
                                                   Foreground="#CBD5E1"
                                                   FontSize="14"/>
                                        <TextBox Grid.Row="1"
                                                 x:Name="TranslatedTextTextBox"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="True"
                                                 Focusable="False"
                                                 Watermark="Здесь появится переведённый текст"
                                                 Background="#111827"
                                                 Foreground="#E2E8F0"
                                                 BorderBrush="#334155"
                                                 BorderThickness="1"
                                                 CornerRadius="8"
                                                 Padding="12"
                                                 TextWrapping="Wrap"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VerticalAlignment="Stretch"
                                                 VerticalContentAlignment="Top"/>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="3" ColumnDefinitions="2*,6*,2*">
                                    <Grid Grid.Column="1" HorizontalAlignment="Center">
                                        <Button x:Name="StartTranslationButton"
                                                Click="StartTranslation"
                                                Content="Начать перевод"
                                                Background="#16A34A"
                                                Foreground="White"
                                                CornerRadius="12"
                                                Height="56"
                                                Width="300"
                                                FontWeight="Bold"
                                                FontSize="18"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                TextBlock.TextAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>

</Window>
